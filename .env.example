MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=self_checkout
MYSQL_USER=checkout
# generate strong passwords, e.g.: openssl rand -hex 16
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8088

WEB_PORT=8088

INACTIVITY_TIMEOUT_SECONDS=120
INACTIVITY_WARNING_SECONDS=15

# Stripe mode teste: sk_test_... / pk_test_... / whsec_... (whsec sai do log do stripe-cli)
# Para configurar o webhook localmente:
#   1. Preencha STRIPE_SECRET_KEY e STRIPE_PUBLISHABLE_KEY com suas keys de teste
#   2. Rode: scripts/stripe-listen.sh (captura o whsec automaticamente)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# opcional: exibido no Dashboard -> acct_...
STRIPE_ACCOUNT_ID=